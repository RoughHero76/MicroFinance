{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@brands/*": ["brands/*"]
    },
    "checkJs": false
  },
  "exclude": ["node_modules", "web", "src/**/*.web.ts", "src/**/*.web.tsx"],
  "include": ["App.tsx", "index.js", "src/**/*", "brands/**/*.json", "__tests__/**/*", "jest.setup.ts", "scripts/**/*"]
}
